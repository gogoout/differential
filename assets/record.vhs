Output demo.webm
Set Shell zsh
Set FontSize 12
Set Height 800
Set Width 1600

Sleep 1.2s
Type "dfr review"
Enter
Sleep 500ms
Down@180ms 4
Type " "
Enter

# Splash: the pipeline runs, and the wordmark is worth a beat.
Sleep 1.8s

Down@180ms 6
Up@180ms 4
Tab
Down@80ms 21
Up@150ms 6
Type "z"
Sleep 900ms
Up
Down@55ms 34
Up@150ms 5
Down@85ms 18
Up@150ms 6

# Split so the composer has a frame to open in.
Type "c"
Sleep 400ms
Type "explain this"
Enter
Sleep 500ms

Down@45ms 48
Up@150ms 5
Type "v"
Down@170ms 7
Type "c"
Sleep 600ms
Type "range comment\"
Enter
Type "and multiple lines comments"
Enter
Screenshot screenshot.png
Sleep 1.2s


Tab
Sleep 400ms
Type " "
Down@180ms 2
Sleep 700ms
Tab
Type "f"
Sleep 400ms
Down@200ms 2
Enter
Sleep 1.2s

Type "F"
Sleep 900ms
Down
Up
Enter
Sleep 700ms
Up@200ms 2
Sleep 500ms
Type "y"
Sleep 700ms
Type "F"
Sleep 1s
Type "D"
Sleep 900ms
Type "y"
Tab
Sleep 500ms
Type " "
Up@200ms 2
Sleep 1s
Type "q"
Sleep 600ms

Type "vim"
Enter

Sleep 700ms
Escape
Paste
Sleep 500ms
Enter@150ms 2
Sleep 500ms
Type "paste to your agent!"
Sleep 1.5s
Escape
Type ":q!"
Enter
